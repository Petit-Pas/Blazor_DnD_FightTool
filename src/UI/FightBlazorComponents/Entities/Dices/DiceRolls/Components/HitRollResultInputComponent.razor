@using MudBlazor
@using DnDFightTool.UI.SharedComponents

@inherits StylableComponentBase

@if (RollResult is not null)
{
    <div class="hit-roll-row">
        <DiceRollResultInputComponent RollResult=RollResult Label="D20 Roll" Class="hit-roll-input" />
        <MudText Typo=Typo.body2 Class="hit-roll-modifier">Modifiers: @RollResult.Modifiers.Expression</MudText>
    </div>
}
