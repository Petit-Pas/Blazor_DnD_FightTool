@using DnDFightTool.Domain.CharacterSheet.AbilityScores
@using DnDFightTool.UI.FightBlazorComponents.Entities.Dices.DiceRolls.Components
@using MudBlazor
@using DnDFightTool.UI.SharedComponents.Dialogs
@using DnDFightTool.UI.SharedComponents.Icons

@implements IDisposable

<RollableDialogBase CanValidate=CanValidate OnValidateClick=CloseAsync>
    <MudTable ContainerClass="pt-2" Class="overflow-y-auto" Elevation=2 Items=_rows Dense="true" Striped="true" Hover="true">
        <RowTemplate>
            <MudTd Class="w-1" style="text-wrap: nowrap;">
                <MudText> @context.Fighter.Name </MudText>
            </MudTd>
            <MudTd Style="width: 80px;">
                <DiceRollResultInputComponent RollResult=context.Roll />
            </MudTd>
            <MudTd>
                <MudText> @context.Fighter.AbilityScores.GetModifier(AbilityEnum.Dexterity) </MudText>
            </MudTd>
        </RowTemplate>
    </MudTable>
</RollableDialogBase>