@using DnDFightTool.UI.CharacterSheetBlazorComponents.Damage.Components
@using DnDFightTool.UI.CharacterSheetBlazorComponents.Dices
@using DnDFightTool.Domain.CharacterSheet.Damage
@using DnDFightTool.Domain.CharacterSheet.Dices
@using DnDFightTool.Domain.CharacterSheet.MartialAttacks
@using MudBlazor
@using DnDFightTool.UI.SharedComponents
@using DnDFightTool.UI.SharedComponents.Buttons.AtomicButtonsPreset
@using DnDFightTool.UI.SharedComponents.Icons

@inherits StylableComponentBase

@if (Character is not null)
{
	<div class="@($"f-row h-100 gap-2 overflow-y-auto {Class}")" style="@($"{Style}")">
		<div class="h-100 p-2" style="min-width: 250px;">
			<MudTable T=MartialAttackTemplate Items="@Character.MartialAttacks.Values"
					  Class="@($"h-100 overflow-y-auto")"
					  Dense="true" Striped="true" Hover="true" Elevation=0 Outlined=true
					  OnRowClick=OnAttackClicked RowClassFunc=SelectedRowClassFunc RowClass="cursor-pointer">
				<RowTemplate>
					<MudTd> @context.Name </MudTd>
				</RowTemplate>
			</MudTable>
		</div>

		@if (SelectedAttack != null)
		{
			<div class="hw-100 p-2 f-column">
				<MudText GutterBottom=true Typo=Typo.h5> @SelectedAttack.Name </MudText>

				<div class="d-grid flex-fill-shrink gap-2" style="grid-template-columns: auto 1fr; grid-template-rows: 1fr auto">
					<div>
						<MudText GutterBottom=true> @SelectedAttack.ToHitModifiers.Expression (@SelectedAttack.ToHitModifiers.GetScoreModifier(Character)) </MudText>
						<DamageRollTemplateCollectionComponent Character=Character DamageRolls=SelectedAttack.Damages />
					</div>
					<FightButton OnClick=AttackAsync Label="Attack" Color=Color.Primary Style="grid-row: 2" />

				</div>
			</div>
		}
	</div>
}
