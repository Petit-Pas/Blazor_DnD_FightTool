@using FightBlazorComponents.Entities.Damage
@using FightBlazorComponents.Entities.Dices.DiceRolls.Components
@using MudBlazor
@using SharedComponents.Dialogs

@implements IDisposable

@if (_rollResult is not null)
{
    <RollableDialogBase CanValidate=CanValidate OnValidateClick=ConfirmAsync>
        <div class="static-content">
            <MudSelect T=DnDFightTool.Domain.Fight.Characters.FightingCharacter
                       Label="Target"
                       Variant=Variant.Outlined
                       Adornment=Adornment.Start
                       AdornmentIcon=@Icons.Material.Filled.Person
                       @bind-Value=SelectedTarget
                       ToStringFunc="@(f => f?.Name ?? string.Empty)">
                @foreach (var fighter in AvailableTargets)
                {
                    <MudSelectItem Value=fighter>@fighter.Name</MudSelectItem>
                }
            </MudSelect>

            @if (SelectedTarget is not null)
            {
                <MudText Typo=Typo.subtitle2 Class="mt-4 mb-1">Hit Roll</MudText>
                <HitRollResultInputComponent RollResult=_rollResult.HitRoll />

                <MudText Typo=Typo.subtitle2 Class="mt-4 mb-1">Damage Rolls</MudText>
            }
        </div>

        @if (SelectedTarget is not null)
        {
            <div class="damage-scroll">
                <div class="damage-grid">
                    @foreach (var damageRoll in _rollResult.DamageRolls)
                    {
                        <DamageTypeIconComponent DamageType=damageRoll.DamageType />
                        <MudText Typo=Typo.body2>@damageRoll.Dices.Expression</MudText>
                        <DiceRollResultInputComponent RollResult=damageRoll Label="Damage" />
                        <MudText Typo=Typo.body1 Class="damage-total">@GetDamageTotal(damageRoll)</MudText>
                    }
                </div>
            </div>
        }
    </RollableDialogBase>
}
