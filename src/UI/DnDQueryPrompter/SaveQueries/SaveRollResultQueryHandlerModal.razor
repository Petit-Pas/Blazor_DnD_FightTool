@using DnDEntitiesBlazorComponents.DnDEntities.AbilityScores
@using FightBlazorComponents.Entities.Dices.DiceRolls.Components
@using MudBlazor
@using SharedComponents.Dialogs

@implements IDisposable

<RollableDialogBase CanValidate=CanValidate OnValidateClick=ConfirmAsync>
    <div class="save-header">
        <AbilityChip Ability=_ability Variant=Variant.Outlined Color=Color.Default />
        <MudText Typo=Typo.body1>DC: @_resolvedDc</MudText>
    </div>
    <MudDivider Class="my-2" />
    <div class="save-roll">
        <DiceRollResultInputComponent RollResult=_saveResult Label="d20" />
        <MudText Typo=Typo.body1>@_savingModifier.ModifierString</MudText>
        <MudText Typo=Typo.body1 Class="save-total">= @Total</MudText>
    </div>
</RollableDialogBase>
