@using DnDFightTool.Domain.CharacterSheet.AbilityScores
@using MudBlazor
@using SharedComponents.Buttons.AtomicButtonsPreset
@using SharedComponents.Buttons.ButtonContainers
@using SharedComponents.Icons

<MudDialog Style="max-height: 85vh;" ContentClass="d-flex flex-column overflow-hidden" ActionsClass="" ContentStyle="max-height: calc(85vh - 64px); overflow: hidden;">
    <DialogContent>
        <div class="d-flex flex-column overflow-hidden">
            @ChildContent
        </div>
    </DialogContent>
    <DialogActions>
        <ButtonRow Class="w-100 px-1">
            <RollButton Disabled=@(!IsRollEnabled)
                        OnCLick=RollAsync />
            <ConfirmButton Disabled=@(!CanValidate)
                           OnClick=ValidateAsync />
        </ButtonRow>
    </DialogActions>
</MudDialog>
