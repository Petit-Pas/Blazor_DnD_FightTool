@using DnDFightTool.Domain.DnDEntities.AbilityScores
@using MudBlazor
@using SharedComponents.Buttons.AtomicButtonsPreset
@using SharedComponents.Buttons.ButtonContainers
@using SharedComponents.Icons

<MudDialog Class="hw-50" ContentClass="overflow-hidden" ActionsClass="">
    <DialogContent>
        <div class="hw-100 d-grid py-2" style="grid-template-rows: 1fr auto; gap: 2em;">

            @if (ChildContent is not null)
            {
                <div style="grid-row: 1; overflow-y: auto;">
                    @ChildContent
                </div>
            }
            
            <ButtonRow Style="grid-row: 2">
                <RollButton Disabled=@(!CanRoll)
                            OnCLick=RollAsync />
                <ConfirmButton Disabled=@(!CanValidate)
                               OnClick=ValidateAsync />
            </ButtonRow>
        </div>
    </DialogContent>
</MudDialog>
