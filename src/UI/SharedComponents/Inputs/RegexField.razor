@using DnDFightTool.Infrastructure.Extensions
@using MudBlazor

@typeparam T where T : IRegexValidated
@inherits StylableComponentBase

@if (Value is not null)
{
    <div class=@Class style=@Style>
        <MudTextField Label=@Label
                      Value=@_currentInput
                      ValueChanged="@(async (string value) => { await OnInputChangedAsync(value); })"
                      Validation="@(new Func<string?, string?>(GetValidationError))"
                      Immediate=true />
    </div>
}
