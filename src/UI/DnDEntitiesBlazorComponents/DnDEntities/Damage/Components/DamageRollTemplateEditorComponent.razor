@using DnDEntitiesBlazorComponents.DnDEntities.Dices.DiceThrows.Components
@using MudBlazor
@using SharedComponents.Inputs

@if (Template is not null)
{
    <div class="f-row align-items-center gap-3">
        <DamageTypeEditorComponent @bind-DamageType=@Template.Type />
        <DiceThrowTemplateEditorComponent @ref=_damageField @bind-Value=@Template.Dices />
        <MudIconButton Icon=@Icons.Material.Filled.Delete Color=Color.Error Variant="Variant.Filled" Size=Size.Large
                       Class="rounded-circle" OnClick=Delete />
    </div>
}