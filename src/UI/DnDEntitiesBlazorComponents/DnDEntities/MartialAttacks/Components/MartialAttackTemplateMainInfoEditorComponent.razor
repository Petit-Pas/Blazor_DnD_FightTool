@using DnDEntitiesBlazorComponents.DnDEntities.Dices.DiceThrows.Components
@using MudBlazor
@using SharedComponents

@inherits StylableComponentBase

@if (AttackTemplate is not null)
{
    <MudPaper Class="@("p-3 d-flex flex-column h-100 gap-3" + Class)" Style=@Style Elevation="2" Square>
        <MudText Typo="Typo.h5" Class=""> Main Informations </MudText>
        <MudForm @ref=_form Model="AttackTemplate" Validation="@(AttackTemplateValidator.ValidateValue)" Class="f-column gap-3">
            <MudTextField Label="Name" @bind-Value="AttackTemplate.Name" For="@(() => AttackTemplate.Name)" Typo="Typo.h5" />
            <DiceThrowModifiersTemplateEditorComponent @ref=_diceThrowEditor @bind-Value="AttackTemplate.ToHitModifiers" Label="To Hit Modifiers" />
        </MudForm>
    </MudPaper>
}