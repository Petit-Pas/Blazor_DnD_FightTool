@using DnDFightTool.Domain.CharacterSheet.Damage
@using MudBlazor
@using DnDFightTool.UI.SharedComponents.Icons

<MudTooltip Text=@DamageType.ToReadableString() Placement=Placement.Top>
    <MudMenu MaxHeight="288"
             Icon=@CustomIcons.TwDnd.GetDamageIcon(DamageType)
             Size=Size.Large
             Variant=Variant.Filled
             Color=Color.Primary
             AriaLabel="@($"Damage type: {DamageType.ToReadableString()}")">
        @foreach (var damageType in Enum.GetValues<DamageTypeEnum>())
        {
            <MudMenuItem 
                role="option"
                Icon=@CustomIcons.TwDnd.GetDamageIcon(damageType)
                Label=@damageType.ToReadableString()
                OnClick="() => OnDamageTypeChanged(damageType)">
            </MudMenuItem>
        }
    </MudMenu>
</MudTooltip>