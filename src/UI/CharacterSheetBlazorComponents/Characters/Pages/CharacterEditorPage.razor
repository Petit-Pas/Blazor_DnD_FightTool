@page "/Characters/Edit"
@using CharacterSheetBlazorComponents.AbilityScores
@using CharacterSheetBlazorComponents.Characters.Components
@using CharacterSheetBlazorComponents.DamageAffinities
@using CharacterSheetBlazorComponents.DamageAffinities.Components
@using CharacterSheetBlazorComponents.MartialAttacks
@using CharacterSheetBlazorComponents.MartialAttacks.Components
@using CharacterSheetBlazorComponents.Skills
@using CharacterSheetBlazorComponents.Skills.Components
@using MudBlazor
@using SharedComponents.Buttons.AtomicButtonsPreset
@using SharedComponents.Buttons.ButtonContainers

@if (_character is not null)
{
    <div class="f-column h-100">
        <MudText Typo="Typo.h4" Class="m-2"> @_character.Name </MudText>
        <div class="mb-2 d-grid mud-paper-grid flex-fill-shrink" style="grid-template-rows: 1fr auto;">
            <MudTabs Elevation=2 Rounded=true ApplyEffectsToContainer=true PanelClass="flex-fill-shrink" OnPreviewInteraction="OnPreviewInteraction" @bind-ActivePanelIndex="_tabActiveIndex" Class="h-100">
                <MudTabPanel Class="hw-100" Text="Basic infos">
                    <div class="h-100 mud-paper-grid p-2" style="grid-template-rows: 1fr auto;">
                        <CharacterMainInfoEditorComponent 
                            @ref=_mainInfoComponent
                            Style="min-height: 0;"
                            Character=@_character />
                        <ButtonRow Style="grid-row: 2">
                            <CancelButton OnClick="Cancel" />
                            <SaveButton OnClick="Save" />
                        </ButtonRow>
                    </div>
                </MudTabPanel>
                <MudTabPanel Class="hw-100" Text="Abilities & Skills">
                    <div class="h-100 mud-paper-grid p-2" style="grid-template-columns: 1fr 1fr;grid-template-rows: 1fr auto;">
                        <AbilityScoresEditorComponent 
                            @ref=_abilityScoreComponent 
                            Style="grid-column: 1; min-height: 0"
                            Character=@_character OnChanged="StateHasChanged" />
                        <SkillsEditorComponent 
                            Style="grid-column: 2; min-height: 0;"
                            Character=@_character />
                        <ButtonRow Style="grid-row: 2; grid-column: 1 / span 2;">
                            <CancelButton OnClick="Cancel" />
                            <SaveButton OnClick="Save" />
                        </ButtonRow>
                    </div>
                </MudTabPanel>
                <MudTabPanel Class="hw-100 test" Text=Resistances>
                    <div class="h-100 mud-paper-grid p-2" style="grid-template-rows: 1fr auto;">
                        <ResistancesEditorComponent 
                            Style="min-height: 0;"
                            Character=@_character />
                        <ButtonRow Style="grid-row: 2;">
                            <CancelButton OnClick="Cancel" />
                            <SaveButton OnClick="Save" />
                        </ButtonRow>
                    </div>
                </MudTabPanel>
                <MudTabPanel Class="hw-100 test" Text=Attacks>
                    <div class="h-100 mud-paper-grid p-2" style="grid-template-rows: 1fr auto;">
                        <AttackListEditorComponent 
                            Style="min-height: 0;"
                            Character=@_character />
                        <ButtonRow Style="grid-row: 2;">
                            <CancelButton OnClick="Cancel" />
                            <SaveButton OnClick="Save" />
                        </ButtonRow>
                    </div>
                </MudTabPanel>
            </MudTabs>
        </div>
    </div>
}