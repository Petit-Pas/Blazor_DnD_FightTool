@page "/Attacks/Edit"
@using DnDFightTool.UI.CharacterSheetBlazorComponents.Damage.Components
@using DnDFightTool.UI.CharacterSheetBlazorComponents.MartialAttacks.Components
@using MudBlazor
@using DnDFightTool.UI.SharedComponents.Buttons.AtomicButtonsPreset
@using DnDFightTool.UI.SharedComponents.Buttons.ButtonContainers

@if (_attackTemplate is not null)
{
    <div class="f-column h-100">
        <MudText Typo="Typo.h4" Class="m-2"> @_attackTemplate.Name </MudText>
        <div class="mb-2 d-grid mud-paper-grid flex-fill-shrink" style="grid-template-rows: 1fr auto;">
            <MudTabs Elevation=2 Rounded=true ApplyEffectsToContainer=true PanelClass="flex-fill-shrink" OnPreviewInteraction="OnPreviewInteraction" Class="h-100">
                <MudTabPanel Class="hw-100" Text="Basic infos">
                    <div class="h-100 mud-paper-grid p-2" style="grid-template-rows: 1fr auto; grid-template-columns: 1fr 1fr;">
                        <MartialAttackTemplateMainInfoEditorComponent @ref=_mainInfoComponent
                            AttackTemplate=@_attackTemplate />

                        <DamageRollTemplateCollectionEditorComponent @ref=_damageComponent
                            DamageRollTemplates="_attackTemplate.Damages" />

                        <ButtonRow Style="grid-row: 2; grid-column: 1 / span 2;">
                            <CancelButton OnClick="Cancel" />
                            <SaveButton OnClick="Save" />
                        </ButtonRow>
                    </div>
                </MudTabPanel>
            </MudTabs>
        </div>
    </div>
}
