@using MudBlazor
@using DnDFightTool.UI.SharedComponents
@using DnDFightTool.UI.SharedComponents.Buttons.AtomicButtonsPreset
@using DnDFightTool.UI.SharedComponents.Buttons.ButtonContainers
@using DnDFightTool.UI.SharedComponents.Containers

@inherits StylableComponentBase

@if (Character is not null)
{
    <MudCard Class=@($"h-100 p-3 {Class}") Style=@($"{Style}") Square>
        <div class="f-row align-top">
            <MudText Class="" Typo="Typo.h5"> Attacks </MudText>
            <MudSpacer />
            <AddButton OnClick=AddNew Size="Size.Medium" Style="margin-top: -10px;" />
        </div>
        <div class="h-100 f-column overflow-y-auto gap-2 attack-list">
            @foreach (var attack in Character.MartialAttacks.Values)
            {
                <MudPaper @key="attack.Id" Class="p-4 position-relative" Elevation="4">
                    <MudText>
                        @attack.Name
                    </MudText>
                    <HoverableVanishingRow>
                        <EditButton OnClick="() => Edit(attack)" Size=Size.Small />
						<DuplicateButton OnClick="() => Duplicate(attack)" Size=Size.Small />
					    <DeleteButton OnClick="() => Delete(attack)" Size=Size.Small />
                    </HoverableVanishingRow>
                </MudPaper>
            }
        </div>
    </MudCard>
}