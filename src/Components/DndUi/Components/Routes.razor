@using DnDFightTool.UI.CharacterSheetBlazorComponents.Characters.Pages
@using DnDFightTool.Components.DndUi.Shared.Components

<Router AppAssembly="@typeof(MauiProgram).Assembly"
        AdditionalAssemblies="new [] { typeof(CharacterEditorPage).Assembly, typeof(DnDFightTool.Components.DndUi.Shared.Components.Routes).Assembly }">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(DnDFightTool.Components.DndUi.Shared.Components.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>
