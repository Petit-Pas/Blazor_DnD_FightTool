@page "/fight"

@using DnDFightTool.Domain.Fight.Characters
@using DnDFightTool.UI.FightBlazorComponents.Entities.FightingCharacters.Components;
@using DnDFightTool.UI.FightBlazorComponents.Entities.MartialAttacks
@using DnDFightTool.UI.FightBlazorComponents.Log
@using DnDFightTool.UI.FightBlazorComponents.CombatStatus
@using MudBlazor


<CascadingValue Value="_selectedFighter" Name="SelectedFighter">
    <div class="d-grid hw-100 pa-2" style="grid-template-columns: 1fr 350px; grid-template-rows: 1fr 250px">
        <div class="f-row w-100 flex-wrap justify-content-center align-items-start gap-3 p-3" style="grid-row:1; grid-column:1;">
            @foreach (var fighter in FightContext.Fighters.OrderBy(FightingCharacter.InitiativeSortKey))
            {
                <FightingCharacterTile Fighter=fighter OnSelected="SelectFighter" />
            }
        </div>

        <div style="grid-row:1; grid-column:2; min-height:0; display:flex; flex-direction:column; padding:8px;">
            <DnDLogComponent Style="flex:1; min-height:0;" />
        </div>

        <MudTabs Border=true Position=Position.Left ApplyEffectsToContainer="true" TabPanelsClass="pa-2" Style="grid-row:2; grid-column:1;" Elevation=3>
            <MudTabPanel Text="Attacks">
                <MartialAttackSelectorComponent />
            </MudTabPanel>
        </MudTabs>

        

        <CombatStatusComponent Style="grid-row:2; grid-column:2;" />

    </div>
</CascadingValue>
