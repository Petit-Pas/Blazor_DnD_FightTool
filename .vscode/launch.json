{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DndUi (MAUI Windows)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-dndui-maui",
            "program": "${workspaceFolder}/src/Components/DndUi/bin/Debug/net10.0-windows10.0.19041.0/win-x64/DndUi.exe",
            "args": [],
            "cwd": "${workspaceFolder}/src/Components/DndUi",
            "stopAtEntry": false,
            "env": {
                "DOTNET_ENVIRONMENT": "Development"
            }
        },
        {
            "name": "DndUi.Web (watch + hot reload)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "watch-dndui-web",
            "program": "${workspaceFolder}/src/Components/DndUi.Web/bin/Debug/net10.0/DndUi.Web.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Components/DndUi.Web",
            "stopAtEntry": false,
            "env": {
                "DOTNET_ENVIRONMENT": "Development",
                "DOTNET_WATCH_SUPPRESS_LAUNCH_BROWSER": "1"
            },
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            }
        }
    ]
}