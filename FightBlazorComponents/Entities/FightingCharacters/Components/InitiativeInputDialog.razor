@using DnDFightTool.Domain.DnDEntities.AbilityScores
@using MudBlazor
@using SharedComponents.Buttons.AtomicButtonsPreset
@using SharedComponents.Icons

<MudDialog Class="hw-50" TitleClass="" ContentClass="overflow-hidden" ActionsClass="">
    <DialogContent>
        <div class="hw-100 d-grid py-2" style="grid-template-rows: 1fr auto; gap: 2em;">
                <MudTable ContainerClass="pt-2" Class="overflow-y-auto" Elevation=2 Items="@Fighters" Dense="true" Striped="true" Hover="true">
                    <RowTemplate>
                        <MudTd Class="w-1" style="text-wrap: nowrap;">
                            <MudText> @context.Name </MudText>
                        </MudTd>
                        <MudTd Style="width: 80px;">
                            <MudInput @bind-Value=context.InitiativeRoll />
                        </MudTd>
                        <MudTd>
                            <MudText> @context.AbilityScores.GetModifier(AbilityEnum.Dexterity) </MudText>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            
            <div class="f-row justify-content-end gap-2">
                <RollButton 
                    Disabled=@(!CanRoll)
                    OnCLick=RollAsync />
                <ConfirmButton 
                    Disabled=@(!CanValidate)
                    OnClick=CloseAsync />
            </div>
        </div>
    </DialogContent>
</MudDialog>
